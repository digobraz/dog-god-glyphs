s-glamping.ch/pop-up-glamping/","r":"Glarner Alpen","o":"Graubünden/Grischun/Grigioni"}],[46.85885,9.11695,"",2226,{"r":"Glarner Alpen","o":"Glarus","d":"Es passt 2 oder 3 Zelte, Trinkwasser bekommt mann beim Brunnen und Bach in der nähe. Zeltplatz and die ander Seite der Pass ist viel bessere Lage mit Grasflache.","de":"It fits 2 or 3 Tents, drinking water is available from the nearby sources and stream. Wildcamping on the other side of the pass is much better though, since it has grass."}],[46.91846,9.16986,"Wohnmobil-Stellplatz Hotel Segnes",998,{"w":"https://elm.ch/de/map/detail/wohnmobil-stellplatz-beim-hotel-segnes-d3fd45ec-9a10-4577-bbcb-856c3f24e514.html","r":"Glarner Alpen","o":"Glarus","d":"Registrierung an der Rezeption des Hotels Segnes.","de":"Registration at the reception of Hotel Segnes."}],[46.92383,9.00052,"Unsere kleine Farm",650,{"p":"+41 55 643 22 61","r":"Glarner Alpen","o":"Glarus"}],[46.96463,9.03816,"",571,{"r":"Glarner Alpen","o":"Glarus"}],[46.98498,9.14474,"Stellplatz Engi",771,{"p":"+41 55 642 17 17","w":"https://glarnerland.ch/de/sommer/weitere-erlebnisse/roadtrip-glarnerland.html","r":"Glarner Alpen","o":"Glarus","d":"CHF 15.- Öffnungszeiten:1.4. - 31.10."}],[46.99153,9.05747,"Camp Stein",591,{"w":"https://nomady.camp/cabin/1195/camp-stein/preview","r":"Glarner Alpen","o":"Glarus"}]],"sleep_hut":[[46.81449,9.02649,"Bifertenhütte",2474,{"w":"https://biferten.ch/","r":"Glarner Alpen","o":"Graubünden/Grischun/Grigioni"}],[46.81981,9.20822,"Alp Dadens",1742,{"r":"Glarner Alpen","o":"Graubünden/Grischun/Grigioni"}],[46.84039,9.02934,"Kistenpasshütte",2678,{"p":"+41 79 201 35 13","w":"http://www.kistenpasshuette.ch","r":"Glarner Alpen","o":"Glarus"}],[46.84925,9.1595,"Schneebar Alp Ruschein",2126,{"p":"+41793818288","r":"Glarner Alpen","o":"Graubünden/Grischun/Grigioni"}],[46.85601,9.10396,"Panixerpasshütte",2406,{"r":"Glarner Alpen","o":"Glarus","d":"Diese Hütte hat ein Matrazenlager, Hüttenschlafsack soll mann mitnehmen. Es gibt ein Holzkoc